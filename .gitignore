.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# === Артефакты сборки прошивки ===
*.bin
*.elf
*.map
*.hex
*.d
*.o
*.a
build/
sdkconfig
sdkconfig.old
sdkconfig.defaults.old

# === Логи и дампы ===
# В логах могут быть реальные MAC-адреса плат и node_id
*.log
serial*.txt
.serial_log.txt
*.pcap
*.dump
logs/
captures/

# === Секреты ===
# Даже в публичном репозитории история коммитов остаётся навсегда:
# удаление файла следующим коммитом НЕ убирает его из истории.
.env
.env.*
*.token
*.key
*.pem
secrets*
credentials*

# === Редакторы и ОС ===
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# === Python (для будущих скриптов и тестов) ===
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# === Node.js (для веб-клиента) ===
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.parcel-cache/

# === Временное ===
*.tmp
*.bak
*.orig
.probe/
tmp/
# Служебные файлы среды (PATH-хаки для pwsh)
.path_backup_user.txt
.path_new_user.txt

